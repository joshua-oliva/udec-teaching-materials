% ========== BLOQUES DE CONTENIDO (Cajas) ==========
\tcbset{
    baseBox/.style={
            enhanced, breakable, colback=white, arc=1mm, boxrule=0.6pt, leftrule=4pt,
            fonttitle=\bfseries\normalsize, before skip=1.5em, after skip=1.5em,
            sharp corners=downhill, attach boxed title to top left={xshift=4mm, yshift=-3mm},
            coltitle=white, top=10pt, bottom=4pt, left=8pt, right=8pt, #1
        }
}
\newtcolorbox{boxTeoria}[2][]{baseBox={#1}, colframe=UdeCPrincipal, title={#2}, boxed title style={colback=UdeCPrincipal, sharp corners, rounded corners=northeast, arc=3mm}}
\newtcolorbox{boxAlerta}[2][]{baseBox={#1}, colframe=UdeCAlerta, title={#2}, boxed title style={colback=UdeCAlerta, sharp corners, rounded corners=northeast, arc=3mm}}
\newtcolorbox{boxEjemplo}[2][]{baseBox={#1}, colframe=UdeCAcento, title={#2}, coltitle=black, boxed title style={colback=UdeCAcento, sharp corners, rounded corners=northeast, arc=3mm}}
\newtcolorbox{boxNota}[2][]{baseBox={#1}, colframe=gray!60, title={#2}, boxed title style={colback=gray!60, sharp corners, rounded corners=northeast, arc=3mm}}

% ========== SISTEMA DE PROBLEMAS ==========
\newcounter{problemaNum}

% Numeración inteligente adaptada al número del documento
\renewcommand{\theproblemaNum}{%
    \ifx\numeroDoc\empty \arabic{problemaNum}%
    \else \numeroDoc.\arabic{problemaNum}\fi%
}

% Formato base para Enunciados: Documento.Problema.Contador
\renewcommand{\thefigure}{\theproblemaNum}
\renewcommand{\theequation}{\theproblemaNum-\arabic{equation}}

% Macro de problemas con reinicio total de contadores
\newcommand{\problema}[1][]{%
    \par \vspace{1.5em}%
    \refstepcounter{problemaNum}%
    \setcounter{figure}{0}%    <-- Reinicia figuras para el nuevo problema
    \setcounter{equation}{0}%  <-- Reinicia ecuaciones para el enunciado
    \noindent\ignorespaces%
    {\bfseries Problema \theproblemaNum}%
    \ifstrempty{#1}%
    {\textbf{.}}%
    { \textbf{[#1].}}%
    \enskip\ignorespaces%
}

% ========== SISTEMA DE SOLUCIONES ==========
\newif\if@soluciones
\newcommand{\mostrarSoluciones}{\@solucionestrue}

\newtcolorbox{CajaSolucionDef}{
    enhanced, breakable, frame hidden, boxrule=0pt, colback=white,
    borderline west={3pt}{0pt}{UdeCAcento}, left=12pt, right=0pt, top=5pt, bottom=5pt,
    parbox=false,
    before upper={
            \noindent{\large\bfseries\color{UdeCPrincipal}Solución \theproblemaNum.}\par\vspace{0.5em}
            \setlength{\parindent}{15pt}
        }
}

\AtBeginDocument{
    \if@soluciones
        \newenvironment{solucion}{%
            % Reinicia contadores internos para la solución
            \setcounter{equation}{0}%
            \setcounter{figure}{0}%
            % Formato con 'S' para distinguir que pertenecen a la solución
            \renewcommand{\theequation}{\theproblemaNum-S\arabic{equation}}%
            \renewcommand{\thefigure}{\theproblemaNum-S\arabic{figure}}%
            \begin{CajaSolucionDef}%
                }{%
            \end{CajaSolucionDef}%
            \vspace{5pt}%
        }
    \else
        \excludecomment{solucion}
    \fi
}